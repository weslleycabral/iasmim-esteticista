// Cloudflare Workers com static assets: dist/ (npm run build) + worker/index.ts.
// Publicar: npm run deploy (README, "Publicação").
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "iasmimesteticista",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-27",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page",
    // O Worker roda antes só onde precisa (páginas, textos, /whatsapp, /u/*). Arquivos estáticos saem direto
    // do CDN e não gastam a cota do plano grátis (100 mil requisições/dia).
    "run_worker_first": [
      "/*",
      "!/_astro/*",
      "!/favicon.*",
      "!/apple-touch-icon.png",
      "!/logo-iasmim-esteticista.webp",
      "!/og-iasmim-esteticista.jpg"
    ]
  },
  "d1_databases": [
    {
      "binding": "ACESSOS",
      "database_name": "iasmim-acessos",
      "database_id": "cc09ef6d-b687-4ed1-a9b9-4386563715d5",
      "migrations_dir": "migrations"
    }
  ],
  // Domínio: depois que a zona iasmimesteticista.com.br estiver na conta (README, "Domínio"), tirar o comentário.
  // "routes": [
  //   { "pattern": "iasmimesteticista.com.br", "custom_domain": true },
  //   { "pattern": "www.iasmimesteticista.com.br", "custom_domain": true }
  // ],
  "observability": { "enabled": true }
}
