{
  "name": "iasmim-esteticista-site",
  "type": "module",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "check:dist": "node scripts/check-dist.mjs",
    "verify": "astro build && node scripts/check-dist.mjs",
    "acessos": "node scripts/acessos.mjs",
    "dev:worker": "wrangler dev",
    "types": "wrangler types worker/worker-configuration.d.ts && tsc -p worker",
    "deploy:preview": "npm run verify && wrangler versions upload",
    "deploy": "npm run verify && wrangler deploy"
  },
  "dependencies": {
    "@astrojs/sitemap": "3.7.4",
    "astro": "7.4.4",
    "web-vitals": "6.2.3"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.12",
    "typescript": "6.0.3",
    "wrangler": "4.154.0"
  }
}
