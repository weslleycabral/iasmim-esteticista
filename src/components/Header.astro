---
// Masthead da linha 3C: marca, menu, "Edição Nº {avaliações} · 5,0 no Google", Agendar e,
// abaixo de 760px, o menu compacto em <details>. O item da página atual ganha aria-current="page"
// (sublinhado fixo no desktop, dourado no menu do celular). Colocado pelo Base.astro.
import Edicao from './Edicao.astro';
import { negocio, waLink } from '../lib/site';

interface Props { mensagemWa?: string }
const { mensagemWa } = Astro.props;

const atual = Astro.url.pathname;
const home = atual === '/';
// /bio/ é feita por outro agente: enquanto não existir, o item Instagram aponta para o perfil
const temBio = Object.keys(import.meta.glob('../pages/bio{.astro,/index.astro}')).length > 0;

// Na home os itens rolam até a seção (como no canvas); nas outras páginas vão para a rota.
const itens = [
  { nome: 'Serviços', href: home ? '#servicos' : '/servicos/', pg: 'p. 08', ativo: atual.startsWith('/servicos/') },
  { nome: 'Sobre', href: home ? '#sobre' : '/sobre/', pg: 'p. 04', ativo: atual === '/sobre/' },
  { nome: 'Resultados', href: home ? '#resultados' : '/#resultados', pg: 'p. 20', ativo: false },
  { nome: 'Localização', href: home ? '#localizacao' : '/contato/', pg: 'p. 30', ativo: atual === '/contato/' },
  { nome: 'Instagram', href: temBio ? '/bio/' : negocio.instagram, pg: negocio.instagramUsuario, ativo: atual === '/bio/' },
];
const cur = (ativo: boolean) => (ativo ? 'page' : undefined);
---
<header class="mast">
  <div class="wrap mast-in">
    <a class="disp brand" href={home ? '#topo' : '/'} aria-label={`${negocio.nome}, início`}>IASMIM</a>
    <nav class="nav-d" aria-label="Principal">
      {itens.map((i) => <a href={i.href} aria-current={cur(i.ativo)}>{i.nome}</a>)}
    </nav>
    <span class="lab mast-ed">Edição Nº <Edicao /> · {negocio.avaliacoes.nota} no Google</span>
    <a class="btn" href={waLink(mensagemWa)}>Agendar</a>
    <details class="menu">
      <summary class="lab" aria-label="Abrir menu">Menu</summary>
      <nav aria-label="Principal, menu compacto">
        {itens.map((i) => (
          <a href={i.href} aria-current={cur(i.ativo)}><span class="disp">{i.nome}</span><span class="lab gold">{i.pg}</span></a>
        ))}
      </nav>
    </details>
  </div>
</header>
