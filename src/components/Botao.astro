---
// Botão da linha 3C (.btn com o hover V9). Escuro por padrão; ghost = contorno.
// Dentro de uma seção .dark as cores invertem sozinhas (CSS global).
// Ex.: <Botao href={waLink()} icone="whatsapp">Agendar pelo WhatsApp</Botao>
//      <Botao href={mapsRotaLink} ghost>Como chegar</Botao>
import Icone from './Icone.astro';
interface Props {
  href: string;
  ghost?: boolean;
  icone?: 'whatsapp' | 'instagram';
  externo?: boolean; // abre em outra aba (target=_blank rel=noopener)
  class?: string;
  [atributo: string]: unknown;
}
const { href, ghost = false, icone, externo = false, class: classe, ...resto } = Astro.props;
---
<a class:list={['btn', { ghost }, classe]} href={href} {...(externo ? { target: '_blank', rel: 'noopener' } : {})} {...resto}>{icone && <Icone nome={icone} />}<slot />{externo && <span class="visually-hidden"> (abre em nova aba)</span>}</a>
