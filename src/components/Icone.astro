---
// Ícones de traço do canvas (V9): 18px, viewBox 24, stroke 1.5, cor do texto (currentColor).
// Uso: <Icone nome="whatsapp" /> dentro de um .btn ou .fab (o CSS .ic cuida do tamanho e do deslize no hover).
interface Props { nome: 'whatsapp' | 'instagram'; class?: string }
const { nome, class: classe } = Astro.props;
---
<svg class:list={['ic', classe]} viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
  {nome === 'whatsapp' ? (
    <>
      <path d="M12 3a8.6 8.6 0 0 0-6.08 14.68L3.4 20.6l5-1.21A8.6 8.6 0 1 0 12 3z" />
      <path d="M 16 13.57 v 1.2 a 0.8 0.8 0 0 1-0.87 0.8 a 7.92 7.92 0 0 1-3.45-1.23 a 7.8 7.8 0 0 1-2.4-2.4 a 7.92 7.92 0 0 1-1.23-3.47 A 0.8 0.8 0 0 1 8.84 7.6 h 1.2 a 0.8 0.8 0 0 1 0.8 0.69 a 5.14 5.14 0 0 0 0.28 1.12 a 0.8 0.8 0 0 1-0.18 0.84 L 10.44 10.76 a 6.4 6.4 0 0 0 2.4 2.4 l 0.51-0.51 a 0.8 0.8 0 0 1 0.84-0.18 a 5.14 5.14 0 0 0 1.12 0.28 A 0.8 0.8 0 0 1 16 13.57 z" />
    </>
  ) : (
    <>
      <rect x="3" y="3" width="18" height="18" rx="5" />
      <circle cx="12" cy="12" r="4" />
      <path d="M17.5 6.5h.01" />
    </>
  )}
</svg>
