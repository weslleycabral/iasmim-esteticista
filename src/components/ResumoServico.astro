---
// Caixa "Resumo rápido": fatos fixos do negócio + indicações do .md. Fácil de citar por buscadores e IAs.
import { negocio, mapsLink, precoTexto, VALOR_SOB_CONSULTA, type Servico } from '../lib/site';
interface Props { servico: Servico }
const { servico } = Astro.props;
const d = servico.data;
const preco = precoTexto(servico);
---
<aside class="resumo" aria-labelledby="resumo-titulo">
  <h2 id="resumo-titulo" class="resumo-titulo">{d.nome} em Juazeiro do Norte: resumo</h2>
  <dl>
    <div>
      <dt>Onde fazer</dt>
      <dd>{negocio.nome} — {negocio.endereco.linha} (<a href={mapsLink}>ver no mapa</a>)</dd>
    </div>
    <div>
      <dt>Quem atende</dt>
      <dd><a href="/sobre/">{negocio.profissional}</a>, {negocio.cargo.toLowerCase()}, pós-graduada em Harmonização Facial</dd>
    </div>
    {d.indicacoes.length > 0 && (
      <div>
        <dt>Indicado para</dt>
        <dd>{d.indicacoes.join('; ')}</dd>
      </div>
    )}
    <div>
      <dt>Horário</dt>
      <dd>{negocio.horario.texto}</dd>
    </div>
    <div>
      <dt>Agendamento</dt>
      <dd>WhatsApp {negocio.telefone}</dd>
    </div>
    <div>
      <dt>Valor</dt>
      <dd>{preco ? preco.charAt(0).toUpperCase() + preco.slice(1) : `Valor ${VALOR_SOB_CONSULTA}`}</dd>
    </div>
    <div>
      <dt>Avaliação</dt>
      <dd>{negocio.avaliacao.texto}</dd>
    </div>
    <div>
      <dt>Atende também</dt>
      <dd>Clientes de Crato, Barbalha e de toda a região do Cariri</dd>
    </div>
  </dl>
</aside>
<style>
  .resumo {
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    padding: 1.25rem 1.4rem 0.5rem;
    margin: 0 0 2rem;
  }
  .resumo-titulo {
    font-size: 1.15rem;
    margin: 0 0 0.8rem;
  }
  dl {
    margin: 0;
  }
  dl > div {
    display: grid;
    gap: 0 1rem;
    padding: 0.55rem 0;
    border-top: 1px solid var(--line);
  }
  @media (min-width: 40rem) {
    dl > div {
      grid-template-columns: 9rem 1fr;
    }
  }
  dt {
    font-weight: 650;
    color: var(--muted);
    font-size: 0.93rem;
  }
  dd {
    margin: 0;
  }
</style>
