---
// Rodapé "Expediente" da linha 3C: NAP completo, horário, área atendida e links. Igual em todas as
// páginas (menos /bio/, que não tem rodapé). Tudo sai de src/data/negocio.json.
import Edicao from './Edicao.astro';
import Botao from './Botao.astro';
import { negocio, waLink, enderecoTexto, horarioTexto, cidadesTexto, telLink } from '../lib/site';

interface Props { mensagemWa?: string }
const { mensagemWa } = Astro.props;
const temBio = Object.keys(import.meta.glob('../pages/bio{.astro,/index.astro}')).length > 0;
const cargo = negocio.cargo.charAt(0).toLowerCase() + negocio.cargo.slice(1);
---
<footer id="expediente" class="exp">
  <div class="wrap art" style="padding-top: clamp(56px, 6.6vw, 96px); padding-bottom: 32px">
    <div class="c2 folio rv"><span class="lab gold">p. 34</span><h2 class="lab">Expediente</h2></div>
    <dl class="c6 rv">
      <dt class="lab">Editora</dt><dd>{negocio.profissional}, {cargo}, pós-graduada em Harmonização Facial</dd>
      <dt class="lab">Redação</dt><dd>{negocio.nome} · <span translate="no">{enderecoTexto}</span></dd>
      <dt class="lab">Circulação</dt><dd>{cidadesTexto}</dd>
      <dt class="lab">Horário</dt><dd>{horarioTexto}</dd>
      <dt class="lab">Telefone</dt><dd><a href={telLink}>{negocio.telefone}</a></dd>
    </dl>
    <div class="c4 links rv">
      <Botao href={waLink(mensagemWa)} icone="whatsapp">WhatsApp {negocio.telefone}</Botao>
      <a class="ul" href={negocio.instagram} rel="me" style="font-size: 16px">{negocio.instagramUsuario}</a>
      {temBio && <a class="ul" href="/bio/" style="font-size: 16px">Links da bio</a>}
      <a class="ul" href={negocio.googleAvaliacoes} style="font-size: 16px">Avaliações no Google</a>
    </div>
    <div class="colophon"><span class="disp" style="font-size: 26px; letter-spacing: .04em" aria-hidden="true">IASMIM</span><span class="lab mute">Edição Nº <Edicao /> · {negocio.nome}</span></div>
  </div>
</footer>
