---
import IconWa from './IconWa.astro';
import { waLink } from '../lib/site';
interface Props { mensagem: string; rotulo?: string }
const { mensagem, rotulo = 'Agendar pelo WhatsApp' } = Astro.props;
---
<div class="barra-wa">
  <a class="btn btn-wa" href={waLink(mensagem)} data-wa>
    <IconWa />
    <span>{rotulo}</span>
  </a>
</div>
<style>
  .barra-wa {
    position: fixed;
    z-index: 30;
    left: 0;
    right: 0;
    bottom: 0;
    padding: 0.6rem 1rem calc(0.6rem + env(safe-area-inset-bottom));
    background: rgba(251, 248, 244, 0.97);
    border-top: 1px solid var(--line);
  }
  .barra-wa .btn {
    width: 100%;
    box-shadow: 0 6px 18px rgba(14, 122, 62, 0.25);
  }
  @media (min-width: 48rem) {
    .barra-wa {
      left: auto;
      right: 1.5rem;
      bottom: 1.5rem;
      padding: 0;
      background: none;
      border: 0;
    }
    .barra-wa .btn {
      width: auto;
    }
  }
</style>
