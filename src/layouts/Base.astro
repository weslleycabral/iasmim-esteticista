---
import '../styles/global.css';
import { Font } from 'astro:assets';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Fab from '../components/Fab.astro';
import type { ImageMetadata } from 'astro';
import { negocio, abs, todosServicos, servicoPath } from '../lib/site';
import { website, negocioLd, pessoa, breadcrumbLd, webpageLd, imagensBase, fotoLd, type Migalha } from '../lib/schema';

interface Props {
  title: string;
  description: string;
  migalhas?: Migalha[]; // sem migalhas = página inicial. Só o JSON-LD: a migalha visível é <Migalhas> na página
  ld?: (Record<string, unknown> | null)[]; // nós JSON-LD específicos da página
  mensagemWa?: string;
  rotuloWa?: string;
  atualizado?: Date;
  sobre?: string; // @id da entidade principal da página
  tipoPagina?: string;
  ogImagem?: string;
  ogTipo?: string;
  noindex?: boolean;
  moldura?: boolean; // false = sem masthead, rodapé e botão flutuante (página /bio/)
}

const {
  title,
  description,
  migalhas = [],
  ld = [],
  mensagemWa = 'Olá, Iasmim! Quero agendar um horário.',
  rotuloWa,
  atualizado,
  sobre,
  tipoPagina,
  // JPEG de propósito (não WebP): o WhatsApp, a Meta e o LinkedIn não documentam WebP em og:image. Ver README.
  ogImagem = '/og-iasmim-esteticista.jpg',
  ogTipo = 'website',
  noindex = false,
  moldura = true,
} = Astro.props;

const canonical = abs(Astro.url.pathname);
const e404 = Astro.url.pathname.startsWith('/404');
const servicos = await todosServicos();

// Página de serviço: as fotos do .md (imagem e casos antes/depois) viram ImageObject, ligadas ao
// Service (image) e à página (primaryImageOfPage).
const servico = servicos.find((s) => abs(servicoPath(s.id)) === canonical);
const fotosServico = servico
  ? [servico.data.imagem, ...servico.data.casos.flatMap((c) => [c.antes, c.depois])].filter(
      (f): f is { src: ImageMetadata; alt: string } => Boolean(f?.src),
    )
  : [];
const imagensPagina = await Promise.all(fotosServico.map((f, i) => fotoLd(f.src, f.alt, `${canonical}#foto-${i + 1}`)));
const nosPagina = ld.filter(Boolean).map((n) =>
  n && imagensPagina.length && n['@id'] === `${canonical}#servico` ? { ...n, image: imagensPagina.map((i) => ({ '@id': i['@id'] })) } : n,
);

const grafo = [
  website(),
  negocioLd(servicos),
  pessoa(),
  ...(await imagensBase()),
  webpageLd({
    url: canonical,
    titulo: title,
    descricao: description,
    atualizado,
    sobre,
    tipo: tipoPagina,
    temBreadcrumb: migalhas.length > 0,
    imagem: imagensPagina[0]?.['@id'],
  }),
  migalhas.length ? breadcrumbLd(canonical, migalhas) : null,
  ...imagensPagina,
  ...nosPagina,
].filter(Boolean);

// Data visível no rodapé ("Página revisada em…"); as páginas de serviço já mostram a data no texto
const dataNoRodape = servico ? undefined : atualizado;
const ogAlt = `${negocio.nome}: ${negocio.profissional}, esteticista em Juazeiro do Norte (CE)`;

// remove campos undefined e escapa "<" para não quebrar o <script>
const jsonLd = JSON.stringify({ '@context': 'https://schema.org', '@graph': grafo }).replace(/</g, '\\u003c');
---
<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {!noindex && <link rel="canonical" href={canonical} />}
    <meta name="robots" content={noindex ? 'noindex, follow' : 'index, follow, max-image-preview:large, max-snippet:-1'} />
    <meta name="theme-color" content="#efe9df" />
    <!-- estado oculto dos reveals só com JS; se o script do site não rodar em 4 s, mostra tudo -->
    <script is:inline>document.documentElement.classList.add('js');setTimeout(function(){if(!window.iasmimPronto)document.documentElement.classList.remove('js')},4000)</script>
    <Font cssVariable="--font-gloock" preload />
    <Font cssVariable="--font-archivo" preload />
    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="alternate" type="text/plain" href="/llms.txt" title="Resumo do site para assistentes de IA" />

    <meta property="og:type" content={ogTipo} />
    <meta property="og:locale" content="pt_BR" />
    <meta property="og:site_name" content={negocio.nome} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={e404 ? abs('/') : canonical} />
    <meta property="og:image" content={abs(ogImagem)} />
    <meta property="og:image:type" content="image/jpeg" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={ogAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={abs(ogImagem)} />
    <meta name="twitter:image:alt" content={ogAlt} />

    <meta name="geo.region" content="BR-CE" />
    <meta name="geo.placename" content="Juazeiro do Norte" />
    <meta name="geo.position" content={`${negocio.geo.lat};${negocio.geo.lng}`} />
    <meta name="ICBM" content={`${negocio.geo.lat}, ${negocio.geo.lng}`} />

    <script type="application/ld+json" set:html={jsonLd} />
  </head>
  <body id="topo">
    <a class="skip" href="#conteudo">Pular para o conteúdo</a>
    {moldura && <Header mensagemWa={mensagemWa} />}
    <main id="conteudo">
      <slot />
    </main>
    {moldura && <Footer mensagemWa={mensagemWa} atualizado={dataNoRodape}><Fab mensagem={mensagemWa} rotulo={rotuloWa} /></Footer>}
    <script>
      import '../scripts/site.ts';
    </script>
  </body>
</html>
