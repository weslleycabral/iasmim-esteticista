---
// Página de serviço = uma "matéria" da Edição 229. Sem design de canvas: segue a linha editorial 3C
// (masthead, numeração, filetes, .lab/.disp, grade de 12, citações, botões V9, reveals).
// Ordem AEO: h1 → resposta direta (resumo) → ficha técnica → corpo do .md (## como seções numeradas)
// → [tipos, no hub] → [caso em fotos] → cartas (depoimentos) → perguntas → leia também → agendar.
// Copy do .md; fatos do negocio.json; JSON-LD: Service (+Offer, OfferCatalog no hub), FAQPage, BreadcrumbList.
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Migalhas from '../../components/Migalhas.astro';
import Foto from '../../components/Foto.astro';
import Faq from '../../components/Faq.astro';
import Botao from '../../components/Botao.astro';
import Edicao from '../../components/Edicao.astro';
import {
  negocio, todosServicos, servicosPrincipais, peelings, servicoPath, waLink, msgServico, abs, ehPeeling, dataBR, dataISO,
  reais, horarioTexto, enderecoTexto, type Servico,
} from '../../lib/site';
import { servicoLd, faqLd } from '../../lib/schema';
import { doServico, mesCurto } from '../../lib/depoimentos';

export async function getStaticPaths() {
  const todos = await todosServicos();
  return todos.map((servico) => ({ params: { slug: servico.id }, props: { servico, todos } }));
}

interface Props { servico: Servico; todos: Servico[] }
const { servico, todos } = Astro.props;
const d = servico.data;
const { Content } = await render(servico);
const url = abs(servicoPath(servico.id));
const porId = new Map(todos.map((s) => [s.id, s]));

const peeling = ehPeeling(servico);
const hubPeeling = porId.get('peeling');
const filhos = d.tipo === 'grupo' ? todos.filter((s) => s.id.startsWith(`${servico.id}/`)) : [];

const relacionados = d.relacionados.map((id) => {
  const r = porId.get(id);
  if (!r) throw new Error(`Serviço relacionado "${id}" não existe (em ${servico.id}.md)`);
  return r;
});
const leiaTambem = [...(peeling && hubPeeling && !d.relacionados.includes('peeling') ? [hubPeeling] : []), ...relacionados];

// Numeração editorial: 01…07 para os serviços do sumário; 02.1…02.6 para os peelings (ordem da coleção).
const principais = await servicosPrincipais();
const listaPeelings = await peelings();
const pgs: Record<string, string> = {
  'limpeza-de-pele': 'p. 08', peeling: 'p. 10', microagulhamento: 'p. 12', botox: 'p. 14',
  'preenchimento-labial': 'p. 15', 'herus-hifu': 'p. 16', 'remocao-de-sinais-e-verrugas-com-jato-de-plasma': 'p. 18',
};
const numero = (s: Servico) => {
  if (ehPeeling(s)) {
    const nPai = String(principais.findIndex((p) => p.id === 'peeling') + 1).padStart(2, '0');
    return `${nPai}.${listaPeelings.findIndex((p) => p.id === s.id) + 1}`;
  }
  return String(principais.findIndex((p) => p.id === s.id) + 1).padStart(2, '0');
};
const pagina = (s: Servico) => pgs[s.id] ?? (ehPeeling(s) ? pgs.peeling : '');
const num = numero(servico);
const pg = pagina(servico);

const migalhas = [
  { nome: 'Início', path: '/' },
  { nome: 'Serviços', path: '/servicos/' },
  ...(peeling && hubPeeling ? [{ nome: hubPeeling.data.nome, path: servicoPath('peeling') }] : []),
  { nome: d.nome, path: servicoPath(servico.id) },
];

const servicoNode: Record<string, unknown> = servicoLd(servico);
if (filhos.length) {
  servicoNode.hasOfferCatalog = {
    '@type': 'OfferCatalog',
    name: `Tipos de ${d.nome.toLowerCase()} na Iasmim Esteticista`,
    itemListElement: filhos.map((f) => ({
      '@type': 'Offer',
      itemOffered: { '@type': 'Service', '@id': `${abs(servicoPath(f.id))}#servico`, name: f.data.nome, url: abs(servicoPath(f.id)) },
    })),
  };
}
if (peeling && hubPeeling) servicoNode.isRelatedTo = { '@id': `${abs(servicoPath('peeling'))}#servico` };

const mensagem = msgServico(servico);
const avaliacao = negocio.avaliacao.valor; // "R$ 100"
const preco = d.preco;
const precoCurto = preco ? `${preco.aPartirDe ? 'A partir de ' : ''}${reais(preco.valor)}` : null;
const depoimentos = doServico(servico.id).slice(0, 6);
// "Peeling para Melasma" → "peeling para melasma" (siglas e nomes próprios ficam): para usar no meio da frase
const PROPRIOS = new Set(['Herus', 'Mar', 'Morto', 'Premium', 'Dermapen', 'Rose', 'Mer']);
const emFrase = (nome: string) => nome.split(' ').map((w) => (/^[A-Z]{2,}$/.test(w) || PROPRIOS.has(w) ? w : w.toLowerCase())).join(' ');
const nomeMin = emFrase(d.nome);
const nomeTitulo = (nome: string) => { const f = emFrase(nome); return f.charAt(0).toUpperCase() + f.slice(1); };
const h1Longo = d.h1.length > 48;
// palavra comprida ("Microagulhamento") não cabe a 42 px numa tela de 320–390 px: o título encolhe um pouco
const maiorPalavra = (t: string) => Math.max(...t.split(/\s+/).map((w) => w.length));
const palavraLonga = maiorPalavra(d.h1) >= 15;
const nomeLongo = maiorPalavra(d.nome) >= 15;
const horarioCurto = horarioTexto.replace(/, somente com horário marcado$/, '');
const minusc = (t: string) => t.charAt(0).toLowerCase() + t.slice(1);
const NOTA_FOTOS = 'Foto publicada com autorização da paciente. Resultados variam de pessoa para pessoa.';
const tituloTipos = servico.id === 'peeling' && filhos.length === 6 ? 'Seis fórmulas, uma para cada queixa.' : `Os tipos de ${nomeMin}.`;
---
<Base
  title={d.title}
  description={d.description}
  migalhas={migalhas}
  ld={[servicoNode, faqLd(url, d.faq)]}
  mensagemWa={mensagem}
  atualizado={d.atualizado}
  sobre={`${url}#servico`}
>
  <article>
    <section class="wrap" aria-label="Abertura da matéria">
      <Migalhas itens={migalhas} extra={`Matéria, ${pg}`} />
      <div class="open">
        <div class="open-t">
          <p class="lab gold ch">{d.categoria} · Nº {num}</p>
          <h1 class:list={['disp h1 title', { long: h1Longo, lw: palavraLonga }]}>{d.h1}</h1>
          <p class="dek ch">{d.resumo}</p>
          <div class="cta-row ch">
            <Botao href={waLink(mensagem)} icone="whatsapp" data-evento="whatsapp" data-posicao="hero">Agendar pelo WhatsApp</Botao>
            <a class="ul" href="#ficha" style="font-size: 15px">Ficha técnica</a>
          </div>
          <p class="fine ch">Atualizado em <time datetime={dataISO(d.atualizado)}>{dataBR(d.atualizado)}</time>. Texto da {negocio.nome}, {negocio.endereco.cidade} ({negocio.endereco.uf}).</p>
        </div>
        <div class="open-p">
          {d.imagem?.src ? (
            <div class="frame">
              <Foto src={d.imagem.src} alt={d.imagem.alt} prioridade sizes="(min-width: 760px) clamp(260px, 32vw, 420px), calc(100vw - 32px)" widths={[320, 480, 640, 840]} />
              <span class="disp no" aria-hidden="true">{num}</span>
            </div>
          ) : (
            <div class="plate" aria-hidden="true">
              <span class="lab plate-k"><span>Edição Nº <Edicao /></span><span class="mute">{pg}</span></span>
              <span class="disp plate-no">{num}</span>
              <span class:list={['disp plate-ttl', { lw: nomeLongo }]}>{d.nome}</span>
              <span class="lab plate-k b"><span>{precoCurto ?? 'Valor na avaliação'}</span><span class="gold">{d.categoria}</span></span>
            </div>
          )}
        </div>
      </div>
    </section>

    <section id="ficha" class="rule-t" aria-labelledby="t-ficha">
      <div class="wrap sec art">
        <div class="c2 folio rv"><span class="lab gold">{pg}</span><h2 class="lab" id="t-ficha">Ficha técnica</h2></div>
        <dl class="c6 facts rv">
          <dt class="lab">Categoria</dt><dd>{d.categoria}</dd>
          {d.outrosNomes.length > 0 && (<><dt class="lab">Outros nomes</dt><dd>{d.outrosNomes.join(', ')}</dd></>)}
          {d.indicacoes.length > 0 && (<><dt class="lab">Indicado para</dt><dd><ul class="ind">{d.indicacoes.map((i) => <li>{i}</li>)}</ul></dd></>)}
          {d.duracao && (<><dt class="lab">Sessão</dt><dd>{d.duracao}</dd></>)}
          {d.sessoes && (<><dt class="lab">Sessões</dt><dd>{d.sessoes}</dd></>)}
          <dt class="lab">Quem faz</dt><dd>{negocio.profissional}, {minusc(negocio.cargo)}, pós-graduada em Harmonização Facial. Atendimento individual, com hora marcada.</dd>
          <dt class="lab">Onde</dt><dd>{enderecoTexto}</dd>
        </dl>
        <div class="c4 valor rv">
          <span class="lab gold">Valor</span>
          <span class="disp val">{preco ? (<>{preco.aPartirDe && 'A partir de '}<span class="nw">{reais(preco.valor)}</span></>) : 'Na avaliação'}</span>
          <p class="body">
            {preco
              ? `${preco.detalhe ? preco.detalhe.charAt(0).toUpperCase() + preco.detalhe.slice(1) + '. ' : ''}A avaliação custa ${avaliacao} e é descontada do procedimento.`
              : `Definido na avaliação, conforme o seu caso. A avaliação custa ${avaliacao} e é descontada do procedimento, no mesmo dia ou depois.`}
          </p>
          <Botao href={waLink(mensagem)} icone="whatsapp" data-evento="whatsapp" data-posicao="preco">Agendar pelo WhatsApp</Botao>
        </div>
      </div>
    </section>

    {filhos.length > 0 && (
      <section id="tipos" class="rule-t" aria-labelledby="t-tipos">
        <div class="wrap sec art">
          <div class="c2 folio rv"><span class="lab gold">{pg}</span><span class="lab">Os {filhos.length === 6 ? 'seis' : filhos.length} {nomeMin}s</span></div>
          <div class="s3 col" style="gap: clamp(28px, 3vw, 40px)">
            <h2 class="disp h2 mk" id="t-tipos" style="font-size: clamp(36px, 4.4vw, 64px)">{tituloTipos}</h2>
            <div class="subs rv">
              {filhos.map((f) => {
                const pr = f.data.preco;
                return (
                  <a class="sub" href={servicoPath(f.id)}>
                    <span class="sn">{numero(f)}</span>
                    <span class="disp st">{nomeTitulo(f.data.nome)}</span>
                    <span class="sr">{f.data.indicacoes.join('; ')}.</span>
                    <span class="sv">{pr ? (<><b>{pr.aPartirDe ? 'A partir de ' : ''}{reais(pr.valor)}</b>{pr.detalhe ? `, ${pr.detalhe}` : ''}</>) : 'Valor na avaliação'}</span>
                    <span class="ul sgo">Ler</span>
                  </a>
                );
              })}
            </div>
          </div>
        </div>
      </section>
    )}

    <section id="materia" class="rule-t" aria-label="A matéria">
      <div class="wrap sec art">
        <div class="c2 folio rv"><span class="lab gold">{pg}</span><span class="lab">A matéria</span></div>
        <div class="s3 prose">
          <Content />
        </div>
      </div>
    </section>

    {d.casos.length > 0 && (
      <section id="resultado" class="rule-t" aria-labelledby="t-resultado">
        <div class="wrap sec art">
          <div class="c2 folio rv"><span class="lab gold">p. 20</span><span class="lab">Resultado</span></div>
          <div class="s3 col" style="gap: clamp(28px, 3vw, 40px)">
            <h2 class="disp h2 mk" id="t-resultado" style="font-size: clamp(36px, 4.4vw, 64px)">Antes e depois</h2>
            <div class="casos" data-foto-caso>
              {d.casos.map((c, i) => (
                <figure class="caso rv">
                  <div class:list={['ba', { solo: !c.depois }]}>
                    <div class="pic"><Foto src={c.antes.src} alt={c.antes.alt} sizes="(min-width: 1420px) 192px, (min-width: 760px) 29vw, calc(50vw - 22px)" widths={[240, 320, 480, 640, 900]} /></div>
                    {c.depois && <div class="pic"><Foto src={c.depois.src} alt={c.depois.alt} sizes="(min-width: 1420px) 192px, (min-width: 760px) 29vw, calc(50vw - 22px)" widths={[240, 320, 480, 640, 900]} /></div>}
                  </div>
                  <div class="rotulos" aria-hidden="true"><span class="lab">{c.antes.rotulo}</span>{c.depois && <span class="lab">{c.depois.rotulo}</span>}</div>
                  <figcaption class="fine"><span class="lab gold">Fig. {i + 1}</span> {c.legenda}</figcaption>
                </figure>
              ))}
            </div>
            <p class="fine rv" style="max-width: 62ch">{NOTA_FOTOS}{d.casosNota && ` ${d.casosNota}`}</p>
          </div>
        </div>
      </section>
    )}

    {depoimentos.length > 0 && (
      <section id="cartas" class="rule-t" aria-labelledby="t-cartas">
        <div class="wrap sec">
          <div class="art end">
            <div class="c2 folio rv"><span class="lab gold">p. 24</span><span class="lab">Cartas</span></div>
            <div class="c8 rv col" style="gap: 20px">
              <h2 class="disp" id="t-cartas" style="font-size: clamp(28px, 2.8vw, 40px); line-height: 1.1">Quem fez {nomeMin} com a Iasmim escreveu no Google.</h2>
              <div class="cta-row">
                <a class="ul" href={negocio.googleAvaliacoes} style="font-size: 15px" data-evento="google-perfil" data-posicao="cartas">Ler no Google</a>
                <a class="ul" href="/depoimentos/" style="font-size: 15px">Cartas desta edição</a>
              </div>
            </div>
          </div>
          <div class="quotes">
            {depoimentos.map((c) => (
              <figure class="q rv">
                <blockquote class="disp" cite={c.link}>{c.texto}</blockquote>
                <figcaption class="lab mute">{c.nome} · Google, {mesCurto(c.mes)}</figcaption>
              </figure>
            ))}
          </div>
        </div>
      </section>
    )}

    {d.faq.length > 0 && (
      <section id="perguntas" class="rule-t" aria-labelledby="t-faq">
        <div class="wrap sec art">
          <div class="c2 folio rv"><span class="lab gold">p. 32</span><span class="lab">Perguntas</span></div>
          <div class="s3 col" style="gap: clamp(28px, 3vw, 40px)">
            <h2 class="disp h2 mk" id="t-faq" style="font-size: clamp(min(36px, 10.4vw), 4.4vw, 64px)">Perguntas sobre {nomeMin}</h2>
            <Faq itens={d.faq} class="rv" />
            <a class="ul rv" href="/perguntas-frequentes/" style="align-self: start; font-size: 15px">Todas as perguntas</a>
          </div>
        </div>
      </section>
    )}
  </article>

  {leiaTambem.length > 0 && (
    <section id="relacionados" class="exp" aria-labelledby="t-rel">
      <div class="wrap sec art">
        <div class="c2 folio rv"><span class="lab gold">Nesta edição</span><span class="lab">Leia também</span></div>
        <div class="s3 col" style="gap: clamp(28px, 3vw, 40px)">
          <h2 class="disp h2 mk" id="t-rel" style="font-size: clamp(min(36px, 10.4vw), 4.4vw, 64px)">Combina com {nomeMin}</h2>
          <nav class="rel rv" aria-label="Serviços relacionados">
            {leiaTambem.map((r) => (
              <a class="rel-row" href={servicoPath(r.id)}>
                <span class="disp num">{numero(r)}</span>
                <span class="lead"><span class="disp ttl">{r.data.nome}</span><span class="sub2">{r.data.categoria.toLowerCase()}{r.data.preco ? ` · ${r.data.preco.aPartirDe ? 'a partir de ' : ''}${reais(r.data.preco.valor)}` : ''}</span></span>
                <span class="lab pg">{pagina(r) || 'Ler'}</span>
              </a>
            ))}
          </nav>
          <a class="ul rv" href="/servicos/" style="align-self: start; font-size: 15px">Todos os serviços</a>
        </div>
      </div>
    </section>
  )}

  <section class="dark" aria-labelledby="t-cta">
    <div class="wrap sec art end">
      <div class="c7 cta-final">
        <span class="lab gold rv">Para fechar a matéria</span>
        <h2 class="disp h2 mk" id="t-cta">Comece pela avaliação.</h2>
        <p class="lede rv" style="max-width: 46ch">Mande uma mensagem dizendo que leu sobre {nomeMin} e conte o que incomoda. A avaliação custa {avaliacao} e é descontada do procedimento, no mesmo dia ou depois.</p>
      </div>
      <div class="c5 rv col" style="gap: 16px; align-items: start">
        <Botao href={waLink(mensagem)} icone="whatsapp" data-evento="whatsapp" data-posicao="fim-servico">Agendar pelo WhatsApp</Botao>
        <span class="mute" style="font-size: 13px">{negocio.telefone} · {minusc(horarioCurto)}</span>
      </div>
    </div>
  </section>
</Base>

<style>
  /* só da matéria de serviço: abertura com placa tipográfica (ou foto), ficha, corpo numerado, caso em fotos, leia também */
  .col { display: flex; flex-direction: column }
  .open { display: grid; grid-template-columns: minmax(0, 1fr); gap: clamp(28px, 3vw, 48px); padding-top: clamp(24px, 3vw, 44px); padding-bottom: clamp(48px, 5vw, 80px) }
  .open-t { display: flex; flex-direction: column; gap: clamp(18px, 2vw, 26px); min-width: 0 }
  .h1.long { font-size: clamp(34px, 4.4vw, 60px); line-height: 1.02 }
  .h1.lw:not(.long) { font-size: clamp(min(42px, 10.4vw), 5.6vw, 80px) }
  .ch { animation: enter 1.1s var(--ease) .8s both }
  .open-p { min-width: 0 }

  /* placa tipográfica: a abertura da matéria quando não há foto */
  .plate { position: relative; width: 100%; aspect-ratio: 16 / 10; background: var(--paper2); border: 1px solid var(--ink); padding: 7% 7%; display: flex; flex-direction: column; justify-content: space-between; container-type: inline-size; box-shadow: 0 30px 60px -30px rgba(29, 26, 22, .45); animation: plate 1.6s var(--ease) .35s both }
  .plate::before { content: ""; position: absolute; inset: 10px; border: 1px solid var(--ink); pointer-events: none }
  .plate-k { display: flex; justify-content: space-between; gap: 12px; align-items: baseline; min-width: 0 }
  .plate-k > span { overflow: hidden; text-overflow: ellipsis; white-space: nowrap }
  .plate-k.b { flex-direction: column; align-items: start; gap: 6px }
  .plate-k.b > span { white-space: normal }
  .plate-no { font-size: 26cqw; line-height: .8; letter-spacing: -.04em; color: var(--gold); font-variant-numeric: tabular-nums lining-nums }
  .plate-ttl { font-size: clamp(22px, 7cqw, 44px); line-height: 1; letter-spacing: -.01em; text-wrap: balance; margin: 4% 0 }
  @keyframes plate { from { opacity: 0; transform: translateY(40px) } to { opacity: 1; transform: none } }

  /* foto de abertura, quando o .md tem imagem */
  .frame { position: relative; aspect-ratio: 3 / 4; overflow: hidden; background: #2a251f; box-shadow: 0 30px 60px -30px rgba(29, 26, 22, .55); animation: plate 1.6s var(--ease) .35s both }
  .frame img { width: 100%; height: 100%; object-fit: cover; object-position: 50% 18% }
  .frame .no { position: absolute; right: 14px; bottom: 8px; font-size: clamp(48px, 6vw, 88px); line-height: 1; color: #e2c588; opacity: .95 }

  /* ficha técnica */
  .folio h2 { font-weight: 600 }
  .facts { grid-template-columns: minmax(110px, 150px) minmax(0, 1fr) }
  @media (max-width: 359.98px) { .facts { grid-template-columns: minmax(0, 1fr) } }
  .ind { margin: 0; padding: 0; list-style: none; display: flex; flex-direction: column; gap: 4px }
  .ind li::before { content: "— "; color: var(--gold) }
  .valor { display: flex; flex-direction: column; gap: 14px; align-items: start; border-top: 1px solid var(--ink); padding-top: 20px }
  .valor .val { font-size: clamp(36px, 3.4vw, 52px); line-height: 1; letter-spacing: -.02em }
  .valor .nw { white-space: nowrap } /* "R$ 480" não se separa */
  .valor .body { font-size: 15px; line-height: 1.55; max-width: 36ch }
  .valor .btn { margin-top: 6px }

  /* tipos (hub): as linhas do sumário */
  .subs { display: flex; flex-direction: column; border-top: 1px solid var(--ink) }
  .sub { display: grid; grid-template-columns: 2.6rem minmax(0, 1fr); gap: 4px 16px; padding: 16px 0; border-bottom: 1px solid var(--rule); min-height: 56px; transition: padding .6s var(--ease), background .6s var(--ease) }
  .sub:hover { padding-left: 10px; background: var(--paper2) }
  .sub .sn { font-size: 14px; color: var(--gold); font-variant-numeric: tabular-nums; padding-top: 4px }
  .sub .st { font-size: clamp(20px, 1.6vw, 24px); line-height: 1.2 }
  .sub .sr { font-size: 14px; color: var(--mute); line-height: 1.45; grid-column: 2 }
  .sub .sv { font-size: 14px; color: var(--ink2); grid-column: 2 }
  .sub .sv b { font-weight: 500; color: var(--ink) }
  .sub .sgo { grid-column: 2; font-size: 14px; justify-self: start }

  /* o corpo do .md: leitura confortável, perguntas numeradas */
  .prose { max-width: 65ch; counter-reset: q }
  .prose :global(h2) { counter-increment: q; font-family: var(--disp); font-size: clamp(26px, 2.4vw, 34px); line-height: 1.12; letter-spacing: -.01em; margin: clamp(40px, 4.4vw, 60px) 0 18px; padding-top: 22px; border-top: 1px solid var(--ink); display: grid; grid-template-columns: auto minmax(0, 1fr); gap: 0 16px; align-items: baseline }
  .prose :global(h2)::before { content: counter(q, decimal-leading-zero); font-family: var(--sans); font-size: 12px; letter-spacing: .16em; font-weight: 600; color: var(--gold); font-variant-numeric: tabular-nums }
  .prose > :global(h2:first-child) { margin-top: 0; padding-top: 0; border-top: 0 }
  .prose :global(h3) { font-family: var(--disp); font-size: clamp(20px, 1.7vw, 24px); line-height: 1.2; margin: 28px 0 12px }
  .prose :global(h4) { font-size: 16px; font-weight: 600; margin: 24px 0 8px }
  .prose :global(p), .prose :global(li) { font-size: clamp(16px, 1.2vw, 17px); line-height: 1.65; color: var(--ink2) }
  .prose :global(p) { margin: 0 0 1.1em }
